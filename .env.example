# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Production: https://shahrukhfrontend.sraproduction-co.workers.dev

# Admin auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Optional absolute API URL used when rewriting media links
PUBLIC_API_URL=https://shahrukhbackend.vercel.app

# Supabase (PostgreSQL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional: used by npm run db:schema / seed-admin.mjs
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Backblaze B2 (S3-compatible API)
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your-bucket-name
B2_BUCKET_ID=your_bucket_id
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket-name
